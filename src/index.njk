<section class="home-below-fold" aria-label="What I believe about design">
  <p class="pullquote">
    I believe design is about taking the complex and chaotic and making it <strong>accessible</strong> to people, <strong>responsive</strong>, and as <strong>fast</strong> as possible.
  </p>

  <section class="two-column" aria-label="Recent articles and newsletter">
    <section class="home-recent" aria-labelledby="recent-articles-heading">
      <h2 id="recent-articles-heading">Recent Articles</h2>
      <ul class="recent-articles-list">
        {% for post in collections.posts %}
          {% if loop.index <= 5 %}
          <li>
            <article>
              <h3><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
              {% if post.data.description %}
              <p class="article-meta">{{ post.data.description }}</p>
              {% endif %}
            </article>
          </li>
          {% endif %}
        {% endfor %}
      </ul>
    </section>

    <section class="home-newsletter" aria-labelledby="newsletter-heading">
      <h2 id="newsletter-heading">Newsletter</h2>
      <p>I write a newsletter about product design and leadership, with a touch of email and climate tech, once a month.</p>
      <section class="newsletter-signup" aria-label="Newsletter signup">
        <script async src="https://subscribe-forms.beehiiv.com/embed.js"></script>
