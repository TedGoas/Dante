---
layout: default
title: Work
description: Case studies and design work
---

<h1 id="work-heading">Work</h1>

<ol class="work-index__list" aria-labelledby="work-heading">
  {% set atmospheres = ['warm-light', 'amber-dusk', 'cool-dark'] %}
  {% for item in collections.work %}
  <li class="work-index__item">
    <a href="{{ item.url }}" class="work-index__card work-index__card--{{ item.data.index_card_layout }}{% if item.data.index_frame_anchor %} work-index__card--frame-anchor-{{ item.data.index_frame_anchor }}{% endif %}">
      <div class="work-index__stage{% if item.data.index_card_layout != 'full-bleed' %} work-index__stage--atmosphere-{{ atmospheres[loop.index0 % atmospheres.length] }}{% endif %}">
        {% if item.data.index_image %}
        {% if item.data.index_card_layout == 'framed-inset' %}
        <div class="work-index__frame">
          <img
            class="work-index__image"
            src="{{ item.data.index_image }}"
            alt="{{ item.data.index_image_alt or '' }}"
            width="600"
            height="600"
            loading="lazy"
          >
        </div>
        {% else %}
        <img
          class="work-index__image"
          src="{{ item.data.index_image }}"
          alt="{{ item.data.index_image_alt or '' }}"
          width="600"
          height="600"
          loading="lazy"
        >
        {% endif %}
        {% endif %}
      </div>
      <div class="work-index__body">
        <h2 class="work-index__title">{{ item.data.index_title or item.data.title }}</h2>
        {% if item.data.index_summary %}
        <p class="work-index__summary">{{ item.data.index_summary }}</p>
        {% endif %}
      </div>
    </a>
  </li>
  {% endfor %}
</ol>
