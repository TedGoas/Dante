---
layout: default
title: Blog
description: Thoughts on design, development, and building products
---

<div class="blog-index">
  <h1>Blog</h1>

  <section class="post-list" aria-label="Blog posts">
    <ul class="article-list">
      {% for post in collections.posts %}
      <li class="article-list__item">
        <a class="article-list__link" href="{{ post.url }}">
          <span class="article-list__title">{{ post.data.title }}</span>
          <time class="article-list__date" datetime="{{ post.date.toISOString() }}">{{ post.date | readableDate }}</time>
          {% if post.data.description %}
          <span class="article-list__dek">{{ post.data.description }}</span>
          {% endif %}
        </a>
      </li>
      {% endfor %}
    </ul>
  </section>
</div>
