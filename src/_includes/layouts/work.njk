---
layout: default
---

<article class="work-article{% if work_layout_variant %} work-article--{{ work_layout_variant }}{% endif %}">
  {% if featured_image %}
  <figure class="work-featured{% if featured_image_classes %} {{ featured_image_classes }}{% endif %}">
    <div class="img-placeholder" data-placeholder="Project preview" aria-label="Project preview image placeholder"></div>
    <figcaption class="visually-hidden">Featured project preview</figcaption>
  </figure>
  {% endif %}

  <header class="work-header{% if work_header_variant %} work-header--{{ work_header_variant }}{% endif %}">
    <h1 class="work-header__title">{{ title }}</h1>
    {% if work_byline %}
    <p class="work-byline">{{ work_byline }}</p>
    {% endif %}
    {% set introDeck = work_intro_deck or excerpt %}
    {% if introDeck %}
    <p class="work-intro-deck">{{ introDeck }}</p>
    {% endif %}
    {% if not hide_work_period and yearParts %}
    <p class="work-period">
      <time datetime="{{ yearParts.start }}">{{ yearParts.start }}</time>
      –
      {% if yearParts.isPresent %}
      <span>present</span>
      {% else %}
      <time datetime="{{ yearParts.end }}">{{ yearParts.end }}</time>
      {% endif %}
    </p>
    {% elif not hide_work_period and year %}
    <p class="work-period">{{ year }}</p>
    {% endif %}
  </header>

  <section class="work-body writing">
    {{ content | safe }}
  </section>
</article>

{% block footerScripts %}
  <script src="/assets/js/click-to-play.js" defer></script>
  <script src="/assets/js/prototype-embed.js" defer></script>
{% endblock %}
