<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title or site.title }}</title>
  <meta name="description" content="{{ description or site.description }}">

  <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
  <link rel="preload" href="/assets/fonts/geist-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/assets/css/site-fonts.css">
  <link rel="stylesheet" href="/assets/css/styles.css">
  <script>document.documentElement.classList.add("js");</script>

  <link rel="icon" type="image/png" href="/assets/img/favicon.png">

  <meta property="og:title" content="{{ title or site.title }}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">

  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="{{ title or site.title }}">
  <meta name="twitter:description" content="{{ description or site.description }}">
</head>
<body{% if page and page.url == "/" %} class="page--home"{% endif %}>
  <a href="#main" class="skip-link">Skip to main content</a>
  <header class="site-header">
    <div class="layout">
      <nav class="site-nav" aria-label="Primary">
        <a href="/" class="site-brand-link">
          <img src="/assets/img/tg-sig-logo.svg" alt="Ted Goas home" width="145" height="63" class="site-logo">
        </a>
        <div class="site-nav__end">
          <button
            type="button"
            class="site-nav__toggle"
            aria-expanded="false"
            aria-controls="site-nav-list"
          >
            <span class="visually-hidden" data-site-nav-label>Menu</span>
            <span class="site-nav__toggle-bars" aria-hidden="true">
              <span class="site-nav__toggle-bar"></span>
              <span class="site-nav__toggle-bar"></span>
              <span class="site-nav__toggle-bar"></span>
            </span>
          </button>
          <ul class="site-nav-list" id="site-nav-list">
            {% for link in navigation.primary %}
            <li>
              {% set isCurrent = page.url | isCurrentNav(link.href) %}
              <a
                href="{{ link.href }}"
                {% if isCurrent %}aria-current="page"{% endif %}
              ><span class="site-nav__label">
                <span class="site-nav__label-underline" aria-hidden="true"></span>
                {{ link.label }}
              </span></a>
            </li>
            {% endfor %}
          </ul>
        </div>
      </nav>
    </div>
  </header>

  <main id="main" class="site-main">
    <div class="layout content-flow">
      {{ content | safe }}
    </div>
  </main>

  {% include "components/site-footer.njk" %}
  <script src="/assets/js/site-nav.js" defer></script>
  {% block footerScripts %}{% endblock %}
</body>
</html>
