---
layout: default
---
{% from "components/divider.njk" import divider %}

<article class="post">
  <header class="post-header">
    {% if post_label %}
    <p class="post-header__eyebrow">{{ post_label }}</p>
    {% endif %}
    <div class="post-header__intro">
      <div class="post-header__title-stack">
        {% if page.date %}
        <time class="post-header__date" datetime="{{ page.date.toISOString() }}">{{ page.date | readableDate }}</time>
        {% endif %}
        <h1 class="post-header__title">
          {% if title | titleNeedsPeriod %}
            {% set titleTail = title | splitTitleLastWord %}
            {{ titleTail.before }}<span class="title-tail">{{ titleTail.last }}</span>
          {% else %}
            {{ title }}
          {% endif %}
        </h1>
      </div>
      {% if description %}
      <p class="type-dek">{{ description }}</p>
      {% endif %}
    </div>
    {{ divider() }}
  </header>

  <section class="post-body">
    {{ content | safe }}
  </section>

  <footer class="post-footer">
    <nav aria-label="Blog">
      <ul class="post-nav-list">
        <li><a href="/blog" class="btn">Back to Blog</a></li>
      </ul>
    </nav>
  </footer>
</article>
