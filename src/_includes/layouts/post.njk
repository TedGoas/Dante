---
layout: default
---

<article class="post">
  <header class="post-header">
    <h1>{{ title }}</h1>
    {% if page.date %}
    <time datetime="{{ page.date.toISOString() }}">{{ page.date | readableDate }}</time>
    {% endif %}
  </header>

  <section class="post-body">
    {{ content | safe }}
  </section>

  <footer class="post-footer">
    <nav aria-label="Blog">
      <ul class="post-nav-list">
        <li><a href="/blog" class="btn">Back to Blog</a></li>
      </ul>
    </nav>
  </footer>
</article>
