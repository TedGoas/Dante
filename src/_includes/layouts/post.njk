---
layout: default
---

<article class="post">
  <header class="post-header">
    {% if post_label %}
    <p class="post-header__eyebrow">{{ post_label }}</p>
    {% endif %}
    <div class="post-header__intro">
      <div class="post-header__title-stack">
        {% if page.date %}
        <time class="post-header__date" datetime="{{ page.date.toISOString() }}">{{ page.date | readableDate }}</time>
        {% endif %}
        <h1 class="post-header__title">
          {{ title }}{% if title | titleNeedsPeriod %}<span class="post-header__title-end" aria-hidden="true"></span>{% endif %}
        </h1>
      </div>
      {% if description %}
      <p class="type-dek">{{ description }}</p>
      {% endif %}
    </div>
    <hr class="post-header__rule" aria-hidden="true">
  </header>

  <section class="post-body">
    {{ content | safe }}
  </section>

  <footer class="post-footer">
    <nav aria-label="Blog">
      <ul class="post-nav-list">
        <li><a href="/blog" class="btn">Back to Blog</a></li>
      </ul>
    </nav>
  </footer>
</article>
