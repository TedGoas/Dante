<div class="work-gallery__media click-to-play{% if background %} click-to-play--has-background{% endif %}" data-click-to-play style="{% if not background %}--click-to-play-aspect-ratio: {{ frameWidth }} / {{ frameHeight }}; {% endif %}--click-to-play-width: {{ frameWidth }}px; --click-to-play-height: {{ frameHeight }}px; --click-to-play-overlay-width: {{ width }}px; --click-to-play-overlay-height: {{ height }}px;{% if posterObjectViewBox %} --click-to-play-poster-object-view-box: {{ posterObjectViewBox }};{% endif %}"><div class="click-to-play__frame">{% if background %}<img class="click-to-play__background" src="{{ background }}" alt="" width="{{ frameWidth }}" height="{{ frameHeight }}" loading="lazy" decoding="async"><div class="click-to-play__overlay"><img class="click-to-play__poster" src="{{ poster }}" alt="{{ alt }}" width="{{ width }}" height="{{ height }}" loading="lazy" decoding="async"><video class="click-to-play__video" data-video-src="{{ video }}" width="{{ width }}" height="{{ height }}" muted playsinline preload="none" aria-hidden="true"></video><button type="button" class="click-to-play__start"><span class="click-to-play__icon" aria-hidden="true"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M8 5.14v13.72L19 12L8 5.14z" fill="currentColor"/></svg></span><span class="visually-hidden">Play {{ alt }}</span></button></div>{% else %}<img class="click-to-play__poster" src="{{ poster }}" alt="{{ alt }}" width="{{ width }}" height="{{ height }}" loading="lazy" decoding="async"><video class="click-to-play__video" data-video-src="{{ video }}" width="{{ width }}" height="{{ height }}" muted playsinline preload="none" aria-hidden="true"></video><button type="button" class="click-to-play__start"><span class="click-to-play__icon" aria-hidden="true"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M8 5.14v13.72L19 12L8 5.14z" fill="currentColor"/></svg></span><span class="visually-hidden">Play {{ alt }}</span></button>{% endif %}</div></div>
