{
	"name": "tedgoas",
	"version": "1.0.0",
	"description": "Ted Goas is a reliable product designer and front-end developer working on websites, applications, and HTML emails.",
	"scripts": {
		"postinstall": "npm install --prefix workos",
		"clean": "rimraf dist",
		"eleventy:serve": "cross-env NODE_ENV=development eleventy --serve",
		"eleventy:watch": "cross-env NODE_ENV=development eleventy --watch",
		"eleventy:build": "cross-env NODE_ENV=production eleventy",
		"build:workos": "npm run build --prefix workos",
		"watch:workos": "npm run build:watch --prefix workos",
		"start:workos": "npm run dev --prefix workos",
		"start": "npm run clean && concurrently -k -n site,workos -c blue,magenta \"npm run eleventy:serve\" \"npm run start:workos\"",
		"serve": "npm run start",
		"watch": "npm run clean && npm run eleventy:watch",
		"build": "npm run clean && npm run eleventy:build && npm run build:workos",
		"debug": "DEBUG=Eleventy* npm run build"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/TedGoas/Dante.git"
	},
	"author": "Ted Goas",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/TedGoas/Dante/issues"
	},
	"homepage": "https://github.com/TedGoas/Dante#readme",
	"devDependencies": {
		"@11ty/eleventy": "^3.0.0",
		"concurrently": "^10.0.5",
		"cross-env": "^7.0.3",
		"html-minifier": "^4.0.0",
		"luxon": "^3.4.0",
		"rimraf": "^5.0.0",
		"terser": "^5.24.0"
	}
}
